ENVIRONMENT=development
SECRET_KEY=change-this-to-a-long-random-string-in-production

# Neon PostgreSQL (Dashboard → Connection string → SQLAlchemy / psycopg2)
# Use the pooler URL for production (Neon → Connect → Pooled connection).
# Example: postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

SESSION_COOKIE_NAME=doctor_session
SESSION_MAX_AGE_HOURS=24
SESSION_RATE_LIMIT_ATTEMPTS=10
SESSION_RATE_LIMIT_WINDOW_SECONDS=900
S3_PRESIGN_EXPIRY_SECONDS=900

# Database pool (per app process). Total connections ≈ workers × (DB_POOL_SIZE + DB_MAX_OVERFLOW).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Static assets (css/, js/, vendor/) Cache-Control max-age in seconds (default 7 days).
STATIC_CACHE_SECONDS=604800

# Sign-in: mobile number only (OTP optional, default off)
OTP_ENABLED=false

CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Production process count (gunicorn). See README for capacity planning.
# WEB_CONCURRENCY=4

# Cron keep-alive (optional): hit GET /api/health every 10–14 minutes. See ops/health_ping.sh
# HEALTHCHECK_URL=https://your-app.example.com
